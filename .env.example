# LeaseGuard environment configuration — the single environment contract for every process.
# Copy to `.env` at the repository root (`cp .env.example .env`). The backend API, the worker, the
# Python service and the Vite frontend all read this one file. Never commit `.env`.
#
# Each variable is validated at startup by the process that uses it:
#   backend/src/config/env.ts                         API and worker (zod)
#   python-services/document-processing/app/core/config.py   document-processing service (pydantic)
#   frontend/src/services/api/config.ts               frontend (zod; only VITE_* variables reach the browser)
# Docker Compose (docker-compose.yml) reads the same file and overrides host names for containers.

NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (the Python service maps these to its own levels)
LOG_LEVEL=info

# --- Backend API -------------------------------------------------------------
API_PORT=3000
# Comma-separated browser origins allowed by CORS (the Vite dev server by default).
API_CORS_ORIGINS=http://localhost:5173

# --- Supabase (local values are printed by `pnpm db:status`) ----------------------
SUPABASE_URL=http://127.0.0.1:54321
# Public anon key. Requests made with it are subject to Row Level Security.
SUPABASE_ANON_KEY=
# Service-role key bypasses RLS. Worker process only. Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATEMENTS_BUCKET=statements
SUPABASE_LEASE_DOCUMENTS_BUCKET=lease-documents
# Tooling only (`pnpm db:push:remote`): the database password of the hosted project named by
# SUPABASE_URL, used to apply supabase/migrations. No application process reads it. Leave empty locally.
SUPABASE_DB_PASSWORD=
# Tooling only, optional: the session-pooler connection string from the dashboard (Connect > Session
# pooler), e.g. postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave the [YOUR-PASSWORD] placeholder in place; SUPABASE_DB_PASSWORD is substituted. Set it when your
# network has no IPv6: the direct host db.<ref>.supabase.co is IPv6-only. Must match SUPABASE_URL's project.
# SUPABASE_DB_POOLER_URL=
# Docker Compose only: the Supabase URL as seen from inside containers. Leave unset for the local CLI
# stack (http://host.docker.internal:54321); set it to the https://<ref>.supabase.co URL for a hosted project.
# DOCKER_SUPABASE_URL=

# --- Redis and BullMQ (API enqueues, worker processes) -----------------------------
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=leaseguard

# --- Document-processing service (Python) -----------------------------------------
DOCUMENT_PROCESSING_URL=http://127.0.0.1:8000
# Shared secret the worker sends as a bearer token. At least 32 random characters in production.
DOCUMENT_PROCESSING_TOKEN=local-dev-only-change-me
# Largest statement PDF accepted, in MiB (API upload validation and Python service limit).
DOCUMENT_PROCESSING_MAX_FILE_MB=20

# --- WhatsApp Business (Meta Cloud API) -----------------------------------------------
# Sending (worker). Per-company access tokens are never stored in plain database columns.
# `whatsapp_phone_numbers.access_token_reference` is either `secret://vault/<secret id>` (Supabase Vault;
# no variable needed; Embedded Signup will store each business's token this way) or
# `secret://env/WHATSAPP_ACCESS_TOKEN_<COMPANY_ID_HEX_UPPERCASE>`, a variable named after the company
# (its uuid without dashes, in uppercase); the worker refuses any other variable.
# Derive the name with: echo "<company uuid>" | tr -d '-' | tr 'a-f' 'A-F'
# Only the worker loads these. Add one line per connected company (never commit real tokens), e.g. for
# the local demo company Nexus Solution (3ab0fc4a-eadb-50b8-bc4d-5673ada1519e):
# WHATSAPP_ACCESS_TOKEN_3AB0FC4AEADB50B8BC4D5673ADA1519E=
# Read by: worker (sending) and API (Embedded Signup code exchange, server to server). Not secret. The API
# defaults to https://graph.facebook.com and v27.0 when unset, and accepts plain http only for a loopback host
# outside production (a local fake Graph server in tests).
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com
# Read by: worker and API. The Graph API version LeaseGuard is built against (docs/integrations/whatsapp-embedded-signup-research.md).
WHATSAPP_GRAPH_API_VERSION=v27.0

# Meta app (LeaseGuard as a WhatsApp Tech Provider). All optional: without them local development works and
# Settings > Integrations > WhatsApp says what is missing. Values come from the Meta App Dashboard; see
# docs/integrations/whatsapp.md. Being set here does not mean Meta has approved the app (Business
# Verification, App Review and Advanced Access happen in Meta, outside LeaseGuard).
# Read by: API and worker. Public: the API hands it to the browser for the Facebook JavaScript SDK (numeric); the
# worker uses it with the app secret to verify numbers (Meta's debug_token).
WHATSAPP_APP_ID=
# Read by: API. Public: the Embedded Signup configuration id (Facebook Login for Business > Configurations, numeric).
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Read by: API and worker. SECRET: the API exchanges Embedded Signup codes and verifies webhook signatures; the worker
# authenticates Meta's debug_token while verifying a number (without it numbers cannot be verified). Never a VITE_ value.
WHATSAPP_APP_SECRET=
# Read by: API only. SECRET: the token Meta echoes in the webhook verification handshake. Never a VITE_ value.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Not read by any LeaseGuard process: a single test number's WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID and
# WHATSAPP_BUSINESS_MESSAGING_ACCOUNT_ID from the Meta App Dashboard are never a global sending channel. Each
# company sends only through its own numbers (whatsapp_phone_numbers).

# --- AI agent (Anthropic), used by the worker -------------------------------------------
# Read by: worker only. SECRET: the per-company AI agents call Claude with it. Optional; the API never loads it
# (the worker reports only whether it is set). Never a VITE_ value. Without it every message a company's agent would
# handle is handed to a person.
ANTHROPIC_API_KEY=
# Read by: worker only. Not secret. How much effort the agent's model (claude-opus-5-5) spends per message:
# low (default), medium or high.
WHATSAPP_AGENT_EFFORT=low

# --- Web app links (worker and operator tooling) ------------------------------------
# Public URL of the frontend. Invitation emails link to ${WEB_APP_URL}/auth/accept, which must be in the
# Supabase Auth redirect allow-list (supabase/config.toml locally, Auth > URL Configuration when hosted).
# Must be https when NODE_ENV=production.
WEB_APP_URL=http://localhost:5173

# --- Outgoing email (operator tooling only: pnpm auth:configure:remote) --------------
# Supabase Auth sends every email (invitations, password links). Locally they are captured by Mailpit
# (http://127.0.0.1:54324). The hosted project delivers them to each user's own address through this
# SMTP server, sent from SMTP_SENDER_EMAIL, whose domain must be verified with the provider (SPF/DKIM).
# These are read only by infrastructure/scripts/configure-auth-remote.mjs, never by the API, worker or
# browser. Leave SMTP_HOST/USER/PASS empty to keep Supabase's test sender (team addresses only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=noreply@leaseguard.com
SMTP_SENDER_NAME=LeaseGuard
# Supabase personal access token (Dashboard > Account > Access Tokens) for the Management API.
SUPABASE_ACCESS_TOKEN=

# --- Frontend (Vite). Only VITE_* variables are exposed to the browser; never put secrets here. ---
# All three are required: the web app signs in with Supabase Auth and reads every record from the API.
VITE_API_URL=http://127.0.0.1:3000
VITE_SUPABASE_URL=http://127.0.0.1:54321
# The same public anon key as SUPABASE_ANON_KEY (safe for browsers; RLS applies).
VITE_SUPABASE_ANON_KEY=
