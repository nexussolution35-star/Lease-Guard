{
  "name": "@leaseguard/reports",
  "version": "0.0.0",
  "private": true,
  "description": "LeaseGuard reports service (ADR 0003): company-scoped reports computed from verified records, reached through the gateway at /api/v1/reports.",
  "type": "commonjs",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node ../../packages/service-kit/scripts/workspace-build.mjs && pnpm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src scripts",
    "test": "vitest run",
    "openapi:generate": "pnpm run build && node --env-file=.env.example dist/generate-openapi.js"
  },
  "dependencies": {
    "@leaseguard/domain": "workspace:*",
    "@leaseguard/service-kit": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@supabase/supabase-js": "^2.119.0",
    "nestjs-pino": "^5.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "oxlint": "^1.92.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
