{
  "name": "@leaseguard/service-kit",
  "version": "0.0.0",
  "private": true,
  "description": "What every LeaseGuard HTTP service shares (ADR 0003): Supabase JWT and company checks, the RLS-bound database client, config validation, logging, health, error mapping and OpenAPI setup.",
  "type": "commonjs",
  "exports": {
    ".": {
      "@leaseguard/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@leaseguard/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@leaseguard/domain": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@supabase/supabase-js": "^2.119.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "oxlint": "^1.92.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
