# Core API (backend, node dist/main.js): the settings only the API reads. Copy to env/api.env; never commit it.
# Validated at startup by backend/src/config/env.ts. compose.yml sets NODE_ENV=production, the port, the CORS origin
# (https://${APP_DOMAIN}), Supabase, Redis, the queue prefix and the Meta app id/secret from ../.env; do not repeat them.
# SECRET marks a value that must stay private.

# SECRET. The token Meta echoes in the webhook verification handshake; enter the same value in the Meta App Dashboard
# (WhatsApp > Configuration > Verify token). `openssl rand -hex 32`.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Public, numeric: the Embedded Signup configuration id (Facebook Login for Business > Configurations).
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# SECRET, optional. Address suggestions (Google Places API (New)); restrict the key to the Places API and to the
# server's outgoing IP address. Without it address fields are plain inputs.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_URL=https://places.googleapis.com
ADDRESS_LOOKUP_DAILY_LIMIT=5000
