{
  "name": "leaseguard",
  "version": "0.0.0",
  "private": true,
  "description": "LeaseGuard commercial lease monitoring and tenant communication platform (pnpm monorepo).",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @leaseguard/frontend dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}
