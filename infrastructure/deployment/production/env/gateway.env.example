# Gateway (Caddy, infrastructure/gateway/caddy). Copy to env/gateway.env. The domains come from ../.env.
#
# The email address Let's Encrypt registers the certificates under (expiry and problem notices go there).
# `internal` makes Caddy use its own local CA instead: only for a local proof run on test domains; browsers and Meta
# refuse those certificates.
GATEWAY_TLS=ops@example.co.za
