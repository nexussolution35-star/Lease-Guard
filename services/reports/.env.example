# LeaseGuard reports service configuration. Copy to `services/reports/.env` (`cp services/reports/.env.example
# services/reports/.env`) or set the variables in the process environment. Never commit `.env`.
# Validated at startup by services/reports/src/config/env.ts (zod). The service holds no service-role key: every
# query runs with the caller's own token, so Row Level Security applies.
#
# Local development: a variable missing here and in the environment is read from backend/.env when that file exists,
# for the shared settings only (NODE_ENV, LOG_LEVEL, SUPABASE_URL, SUPABASE_ANON_KEY, REDIS_URL), so the reports
# service talks to the same Supabase project as the core service without copying the key.

NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Port of the reports service (default 3100). The gateway (Vite dev proxy, infrastructure/gateway) sends
# /api/v1/reports here.
REPORTS_PORT=3100
# Comma-separated browser origins allowed by CORS (default http://localhost:5173, the Vite dev server).
REPORTS_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Supabase (local values are printed by `pnpm db:status`). Public anon key only; Row Level Security applies.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Redis: readiness, and the queue through which the core messaging pipeline is asked to send messages.
REDIS_URL=redis://127.0.0.1:6379
