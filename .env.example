# LeaseGuard environment configuration.
# Copy to `.env` at the repository root. Every app (backend API, worker, Python service)
# reads this one file, so each variable is defined once. Never commit `.env`.

NODE_ENV=development
LOG_LEVEL=info

# --- Backend API -------------------------------------------------------------
API_PORT=3000
# Comma-separated browser origins allowed by CORS (the Vite dev server by default).
API_CORS_ORIGINS=http://localhost:5173

# --- Supabase (local values are printed by `pnpm supabase:status`) -----------
SUPABASE_URL=http://127.0.0.1:54321
# Public anon key. Requests made with it are subject to Row Level Security.
SUPABASE_ANON_KEY=
# Service-role key bypasses RLS. Backend workers only. Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for migrations and database tests.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_STATEMENTS_BUCKET=statements
SUPABASE_LEASE_DOCUMENTS_BUCKET=lease-documents

# --- Redis and BullMQ ----------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=leaseguard

# --- Document-processing service (Python) -----------------------------------------
DOCUMENT_PROCESSING_URL=http://127.0.0.1:8000
# Shared secret the backend sends as a bearer token. Use a long random value outside local dev.
DOCUMENT_PROCESSING_TOKEN=local-dev-only-change-me
DOCUMENT_PROCESSING_MAX_FILE_MB=20

# --- WhatsApp Business (Meta Cloud API) -----------------------------------------
# Leave empty until Meta onboarding is complete. Per-company access tokens are stored
# server-side and referenced by id; they never appear in this file or the frontend.
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
