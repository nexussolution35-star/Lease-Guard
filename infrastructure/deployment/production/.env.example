# LeaseGuard production deployment: the shared settings (compose.yml reads this file for ${...} values).
# Copy to `.env` next to compose.yml on the server (`cp .env.example .env`, then `chmod 600 .env`). Never commit it.
# SECRET marks a value that must stay private. Generate random secrets with `openssl rand -hex 32`.
# Each service's own settings live in env/<service>.env (copy env/*.env.example the same way).
# Runbook: docs/deployment/README.md.

# --- Domains --------------------------------------------------------------------------------------------------------
# The two public host names. Caddy obtains a Let's Encrypt certificate for each and the services derive every URL and
# CORS origin from them: the web app is https://${APP_DOMAIN}, the API (and the WhatsApp webhook) https://${API_DOMAIN}.
#
# First run, before LeaseGuard has its own domain: use the server's public IPv4 address with sslip.io, a public DNS
# service that answers <anything>.<ip>.sslip.io with <ip>, so no DNS records are needed. Replace 203.0.113.10 with
# the server's address (dots or dashes both work: app.203-0-113-10.sslip.io). nip.io works the same way.
#   WhatsApp webhook: https://api.203.0.113.10.sslip.io/api/v1/webhooks/whatsapp
# Later, with a real domain: change these two lines, add the DNS records, and follow "Switching to a real domain" in
# the runbook (Meta callback URL, Supabase Auth URLs, the GitHub variables and a frontend rebuild).
APP_DOMAIN=app.203.0.113.10.sslip.io
API_DOMAIN=api.203.0.113.10.sslip.io

# --- Images ---------------------------------------------------------------------------------------------------------
# GitHub Container Registry namespace (lowercase owner) and the tag to run: a commit SHA from CI (immutable; use it in
# production), or `main` / `develop` (moves with the branch). Rollback: set the previous SHA, then pull and up -d.
IMAGE_REGISTRY=ghcr.io/<github-owner-lowercase>
IMAGE_TAG=<commit-sha>

# --- Supabase (hosted) ----------------------------------------------------------------------------------------------
# Dashboard > Project Settings > API.
SUPABASE_URL=https://ilplapsqrbcviqlhnzov.supabase.co
# Public anon key (Row Level Security applies): API and reports service. Required in production.
SUPABASE_ANON_KEY=
# SECRET. Bypasses Row Level Security: core worker and reports worker only, never the API, reports or browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATEMENTS_BUCKET=statements
SUPABASE_LEASE_DOCUMENTS_BUCKET=lease-documents

# --- Redis (queues) -------------------------------------------------------------------------------------------------
# SECRET. Hex only (it is placed in redis://:<password>@redis:6379): `openssl rand -hex 32`.
REDIS_PASSWORD=
# Largest memory Redis may use; it never evicts (noeviction), so writes fail loudly when full. Below REDIS_MEMORY.
REDIS_MAXMEMORY=512mb
# BullMQ key prefix: identical for every process.
QUEUE_PREFIX=leaseguard

# --- Document processing ----------------------------------------------------------------------------------------------
# SECRET. Bearer token the worker sends to the document-processing service; at least 32 characters.
DOCUMENT_PROCESSING_TOKEN=
DOCUMENT_PROCESSING_MAX_FILE_MB=20

# --- Meta app (WhatsApp Tech Provider), read by the API and the worker ------------------------------------------------
# Public numeric app id (Meta App Dashboard).
WHATSAPP_APP_ID=
# SECRET. Verifies webhook signatures and exchanges Embedded Signup codes (API); verifies numbers (worker).
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v27.0

# --- Logging, scaling, limits -----------------------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
API_REPLICAS=1
WORKER_REPLICAS=1
REPORTS_REPLICAS=1
REPORTS_WORKER_REPLICAS=1
DOCUMENT_PROCESSING_REPLICAS=1
# Per container: <NAME>_CPUS and <NAME>_MEMORY for GATEWAY, FRONTEND, API, WORKER, REPORTS, REPORTS_WORKER,
# DOCUMENT_PROCESSING and REDIS override the defaults in compose.yml, e.g.
# API_MEMORY=768M
# WORKER_MEMORY=1G

# --- Ports (leave as is on a server) ------------------------------------------------------------------------------
# Let's Encrypt needs 80 and 443 on the public address.
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
