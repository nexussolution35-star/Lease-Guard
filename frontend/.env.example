# LeaseGuard web app configuration: public values only. Copy to `frontend/.env`
# (`cp frontend/.env.example frontend/.env`). Vite compiles every VITE_* value into the JavaScript bundle, so
# anyone who loads the app can read them: never put a secret here. Server settings and secrets live in
# backend/.env; the build refuses to start if a VITE_* value holds one of them.
#
# Validated at startup by frontend/src/services/api/config.ts. All three are required: the web app signs in
# with Supabase Auth and reads every record from the API.
VITE_API_URL=http://127.0.0.1:3000
VITE_SUPABASE_URL=http://127.0.0.1:54321
# The same public anon key as SUPABASE_ANON_KEY in backend/.env (safe for browsers; Row Level Security applies).
VITE_SUPABASE_ANON_KEY=
