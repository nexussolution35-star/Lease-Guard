# Core worker (backend, node dist/worker.js): the settings only the worker reads. Copy to env/worker.env; never commit.
# Validated at startup by backend/src/config/env.ts. compose.yml sets NODE_ENV=production, Supabase (with the
# service-role key), Redis, the document-processing URL and token, the Meta app and WEB_APP_URL (https://${APP_DOMAIN},
# used in invitation emails) from ../.env; do not repeat them. SECRET marks a value that must stay private.

# SECRET, optional. Anthropic API key for the companies' WhatsApp AI agents. Without it every message an agent would
# handle goes to a person.
ANTHROPIC_API_KEY=
# low (default) | medium | high
WHATSAPP_AGENT_EFFORT=low

# SECRET, one line per company whose token is kept here rather than in Supabase Vault (Embedded Signup stores tokens in
# Vault, which needs no line). The name is the company uuid without dashes, in uppercase:
#   echo "<company uuid>" | tr -d '-' | tr 'a-f' 'A-F'
# Restart the worker after adding or rotating one (docker compose up -d worker).
# WHATSAPP_ACCESS_TOKEN_<COMPANY_ID_HEX_UPPERCASE>=
